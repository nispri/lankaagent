# LankaAgent — Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to git — use 1Password / Coolify secrets in production

# ─────────────────────────────────────────────────────────────
# CORE APPLICATION
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_TENANT_SCHEMA=public
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=lankaagent
POSTGRES_PASSWORD=changeme-dev-only
POSTGRES_DB=lankaagent
DATABASE_URL=postgresql://lankaagent:changeme-dev-only@postgres:5432/lankaagent

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────
# WHATSAPP (Twilio)
# ─────────────────────────────────────────────────────────────
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta WhatsApp Business API (for production, after approval)
META_VERIFY_TOKEN=your_verify_token
META_APP_SECRET=your_app_secret
META_ACCESS_TOKEN=your_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_WABA_ID=your_waba_id

# ─────────────────────────────────────────────────────────────
# PAYMENTS
# ─────────────────────────────────────────────────────────────
# Stripe (International)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_API_VERSION=2024-04-10

# PayHere (Sri Lanka LKR)
# Get from: https://www.payhere.lk/merchant/settings
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true

# ─────────────────────────────────────────────────────────────
# MCP SERVER
# ─────────────────────────────────────────────────────────────
MCP_SERVER_URL=http://mcp:8000
MCP_API_KEY=dev-mcp-key-change-in-production

# ─────────────────────────────────────────────────────────────
# EXTERNAL INTEGRATIONS
# ─────────────────────────────────────────────────────────────
# Google Calendar
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Maps (for distance/time calculations)
GOOGLE_MAPS_API_KEY=your_maps_api_key

# ─────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────
# PostHog (Analytics)
# Get from: https://app.posthog.com/project/settings
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# Sentry (Error Tracking)
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o1.ingest.sentry.io/123456
SENTRY_ENVIRONMENT=development

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ─────────────────────────────────────────────────────────────
# LLM PROVIDERS (OpenCode Zen primary + OpenRouter fallback)
# ─────────────────────────────────────────────────────────────
# Primary: OpenCode Zen (free tier — powers the web widget concierge)
# Get from: ~/AppData/Local/hermes/.env (OPENCODE_ZEN_API_KEY)
ZEN_API_KEY=sk-...HERE
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=deepseek-v4-flash-free

# Fallback: OpenRouter (used if Zen fails)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek-v4-flash-free

# Model Preferences (fallback chain)
LLM_MODEL_PRIMARY=deepseek-v4-flash-free
LLM_MODEL_FALLBACK_1=openai/gpt-oss-20b:free
LLM_MODEL_FALLBACK_2=anthropic/claude-3.5-sonnet

# ─────────────────────────────────────────────────────────────
# EMAIL (Postmark)
# ─────────────────────────────────────────────────────────────
# Get from: https://account.postmarkapp.com/servers
POSTMARK_SERVER_TOKEN=your_server_token
POSTMARK_FROM_EMAIL=noreply@lankaagent.com
POSTMARK_FROM_NAME=LankaAgent

# ─────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────
ENABLE_WELLNESS_ENGINE=true
ENABLE_MULTILINGUAL=true
ENABLE_ANALYTICS=true
ENABLE_WEBHOOK_RETRY=true

# ─────────────────────────────────────────────────────────────
# DEVELOPMENT OVERRIDES
# ─────────────────────────────────────────────────────────────
# Set to true to skip external API calls in tests
MOCK_EXTERNAL_APIS=false

# Ngrok tunnel for local webhook testing (run: ngrok http 8000)
# NGROK_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app