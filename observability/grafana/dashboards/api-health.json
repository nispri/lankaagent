{
  "title": "LankaAgent API Health",
  "uid": "lankaagent-api-health",
  "tags": ["lankaagent", "api"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "5xx Errors",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "thresholds", "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 0.01, "color": "red"}]}}
        }
      }
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "active_sessions",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds", "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 100, "color": "yellow"}, {"value": 500, "color": "red"}]}}
        }
      }
    },
    {
      "title": "MCP Call Success Rate",
      "type": "timeseries",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "rate(mcp_calls_total{status=\"success\"}[5m])",
          "legendFormat": "Success",
          "format": "time_series"
        },
        {
          "expr": "rate(mcp_calls_total{status=\"error\"}[5m])",
          "legendFormat": "Error",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "LLM Provider Distribution",
      "type": "piechart",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (provider) (rate(llm_calls_total[5m]))",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "LLM Call Status",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(llm_calls_total{status=\"success\"}[5m])",
          "legendFormat": "Success",
          "format": "time_series"
        },
        {
          "expr": "rate(llm_calls_total{status=\"error\"}[5m])",
          "legendFormat": "Error",
          "format": "time_series"
        },
        {
          "expr": "rate(llm_calls_total{status=\"empty\"}[5m])",
          "legendFormat": "Empty",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}